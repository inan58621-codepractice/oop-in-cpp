#include<bits/stdc++.h>
using namespace std;

class Student
{
public: 
    string name;
    int age;

    Student(string n, int a)
    {
        name = n;
        age = a;
    }

    void display()
    {
        cout<<"Name : "<<name<<endl;

        cout<<"Age : "<<age<<endl;

        cout<< endl;
    }
};

int main()
{
    Student s1("Inan", 21);
    Student s2("Rakib", 22);
    Student s3("Sojib", 20);

    s1.display();
    s2.display();
    s3.display();
    return 0 ;
}
